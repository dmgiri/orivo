    "test:automatic:postgres": "node test/auto-node-postgres.mjs",
    "test:automatic:host": "node test/automatic-host-guards.mjs",
    "test:automatic:next": "node test/automatic-next.mjs",
    "test:automatic:vite5": "node test/automatic-vite5.mjs",
    "prepare:ai": "node scripts/prepare-local-ai.mjs",
    "test:ui": "node test/compact-ui.mjs",
    "test:theme-wave": "node test/theme-wave.mjs"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "playwright-core": "1.64.0"
