    "test:themes": "node test/themes-native.mjs",
    "test:index-profiles": "node test/index-profiles-native.mjs",
    "test:diagrams": "node test/diagram-studio-native.mjs",
    "test:lifecycle": "node test/host-lifecycle.mjs",
    "test:launcher": "node test/launcher.mjs",
    "test:product": "node test/product.mjs",
    "test:packaged": "node test/packaged.mjs",
    "check": "node scripts/check.mjs",
    "pack:source": "node scripts/pack.mjs",
    "build:win": "node scripts/build-win.mjs",
    "test:preview": "node test/preview-maximize.mjs",
    "test:resize": "node test/preview-resize.mjs",
    "test:height": "node test/preview-height.mjs",
    "test:zoom": "node test/graph-zoom.mjs",
    "test:trace-tools": "node test/trace-tools.mjs",
    "test:trace-product": "node test/trace-product-native.mjs",
